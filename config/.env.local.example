# =============================================================================
# xynoCMS — variables d'environnement locales
# =============================================================================
# Copie ce fichier en `config/.env.local` et remplis les valeurs.
# Ce fichier NE DOIT PAS être committé (il est dans .gitignore côté CMS via
# `load_env_local()` — vérifie aussi que .env.local est bien ignoré par git).
#
# Le fichier est chargé automatiquement par config/bootstrap.php au démarrage
# de chaque requête PHP.
# =============================================================================


# --- Base URL publique du CMS (HTTPS obligatoire en prod) --------------------
# Utilisée par release_upload.php pour construire les URLs des fichiers.
# Laisse vide si ton serveur web expose déjà HTTP_HOST/REQUEST_SCHEME.
XYNO_PUBLIC_BASE_URL=https://ton-domaine.tld


# --- GitHub Actions (build des launchers) ------------------------------------
# Personal Access Token GitHub avec scope "repo" (classique) OU fine-grained
# avec permission "Actions: Read and write" sur le repo du launcher.
# Génère-le sur : https://github.com/settings/tokens
XYNO_GITHUB_TOKEN=

# Repo GitHub au format "owner/repo" (ex : GratriShow/xynoCMS).
XYNO_GITHUB_REPO=GratriShow/xynoCMS


# --- Tokens partagés CMS ↔ GitHub Actions ------------------------------------
# Chaîne aléatoire (≥32 chars) — à recopier à l'identique dans les Secrets
# du repo GitHub :
#   - BUILD_FETCH_TOKEN  (lit /api/build_config.php + POST /api/build_status.php)
#   - RELEASE_UPLOAD_TOKEN (upload des installers via /api/release_upload.php)
#
# Pour les générer : `openssl rand -hex 32`
XYNO_BUILD_FETCH_TOKEN=
XYNO_RELEASE_UPLOAD_TOKEN=

# Ancien nom de token, toujours utilisé par api/upload_build.php (legacy Mac).
# Tu peux le laisser vide si tu n'utilises plus upload_build.php.
XYNO_BUILD_TRIGGER_TOKEN=


# --- API v2 (auth signée launcher) -------------------------------------------
# Secret HS256 pour les JWT délivrés par /api/v2/session.php.
# Génère-le : `openssl rand -hex 32`
XYNO_JWT_SECRET=

# Si "1", lie chaque session v2 à l'IP cliente (plus strict mais casse en CGNAT).
XYNO_API_ENFORCE_IP=0


# --- Base de données (fallback si non défini dans config/database.php) ------
# Facultatif : si tes creds sont déjà dans config/database.php, laisse vide.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=xynocms
# DB_USER=xyno
# DB_PASS=


# --- Marketplace Stripe (Bloc 3) ---------------------------------------------
# Achats unitaires (10€ par item, paiement unique, par launcher).
#
# Crée tes clés sur : https://dashboard.stripe.com/apikeys
# En test, utilise les cartes fictives : 4242 4242 4242 4242 (tout date future).
#
# STRIPE_SECRET_KEY   : sk_test_xxx (ou sk_live_xxx en prod). Jamais exposée au client.
# STRIPE_PUBLIC_KEY   : pk_test_xxx. Exposée dans le dashboard (pas encore utilisée,
#                      réservée pour un futur flow "Payment Elements").
# STRIPE_WEBHOOK_SECRET : whsec_xxx. Donné par Stripe quand tu crées le webhook
#                        sur https://dashboard.stripe.com/webhooks pointant vers
#                        https://ton-domaine.tld/api/stripe_webhook.php avec les
#                        events : checkout.session.completed,
#                        checkout.session.async_payment_succeeded,
#                        charge.refunded, charge.refund.updated.
# MARKETPLACE_CURRENCY : code ISO 3 caractères (eur, usd, gbp…). Défaut : eur.
# STRIPE_WEBHOOK_TOLERANCE_SECONDS : tolérance replay (défaut 300s).
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
MARKETPLACE_CURRENCY=eur
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300


# --- Emails transactionnels (Resend) -----------------------------------------
# Crée un compte sur https://resend.com puis une API key dans
# https://dashboard.resend.com/api-keys
#
# RESEND_API_KEY   : re_xxx (clé d'API Resend, jamais exposée au client).
#                    Sans cette clé, send_email() renvoie ['error'=>'no_api_key'].
# EMAIL_FROM       : adresse expéditeur (doit être sur un domaine vérifié dans
#                    Resend). Défaut : reply@xynoweb.fr.
# EMAIL_FROM_NAME  : nom affiché. Défaut : XynoLauncher.
# EMAIL_REPLY_TO   : adresse Reply-To. Défaut : contact@xynoweb.fr.
# APP_URL          : URL publique du CMS, utilisée pour construire les liens
#                    dans les emails (vérification, restauration de compte…).
#                    Ex : https://ton-domaine.tld
RESEND_API_KEY=
EMAIL_FROM=reply@xynoweb.fr
EMAIL_FROM_NAME=XynoLauncher
EMAIL_REPLY_TO=contact@xynoweb.fr
APP_URL=https://ton-domaine.tld
